# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://connectx:connectx@localhost:5432/connectx_dev

# Authentication
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ---------------------------------------------------------------------------
# AI (Phase 5) — see docs/ai.md
#
# AI_PROVIDER=none keeps every AI feature in an honest "not configured"
# state (nothing is faked). Set AI_PROVIDER=anthropic plus an API key to
# enable them. The key is only ever read by the backend.
AI_PROVIDER=none
AI_PROVIDER_API_KEY=
AI_MODEL=claude-opus-5
# Effort hint for models that support it: low | medium | high. "default" = omit it.
AI_EFFORT=medium
# Anthropic: re-run a request the model's safety classifiers decline on a fallback model (server-side). Set false to disable.
AI_REFUSAL_FALLBACK=true
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=8000
# Max characters of chat text placed into one AI prompt.
AI_MAX_CONTEXT_CHARS=24000
# Per-user AI request limits.
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_DAY=200

# Speech-to-text for Voice Intelligence. "none" or "whisper-http" (any
# endpoint implementing POST {BASE_URL}/audio/transcriptions, multipart).
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_MAX_AUDIO_MB=25

# File uploads
MAX_UPLOAD_SIZE_MB=25
# Local development media storage directory (relative to backend/ or absolute).
# Replaceable with S3/object storage later via the StorageProvider interface.
UPLOAD_DIR=uploads

# ---------------------------------------------------------------------------
# Voice/video calls (WebRTC) — see docs/calls.md
#
# Media flows peer-to-peer between browsers; the server only relays
# signaling. With NO ICE servers configured, calls work between browsers on
# the same machine or LAN. To call across the internet you need STUN, and
# behind restrictive NATs/firewalls you also need a TURN relay.
#
# Public STUN (reveals client IPs to that STUN provider):
# WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_STUN_URLS=
# Comma-separated TURN URLs, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
WEBRTC_TURN_URLS=
# Option A (recommended): coturn `use-auth-secret` shared secret. The server
# hands each user short-lived credentials derived from it.
WEBRTC_TURN_SECRET=
WEBRTC_TURN_TTL_SECONDS=3600
# Option B: static TURN credentials (every client gets the same ones).
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
# How long an unanswered call rings before it is recorded as missed.
CALL_RING_TIMEOUT_SECONDS=45
